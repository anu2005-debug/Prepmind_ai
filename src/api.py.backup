# ============================================================
# LIVE CLASSES SCHEMA
# ============================================================

def ensure_live_classes_schema():

    connection = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS live_classes (
                id SERIAL PRIMARY KEY,
                title VARCHAR(255) NOT NULL,
                subject VARCHAR(100) NOT NULL,
                chapter VARCHAR(255),
                teacher VARCHAR(255),
                description TEXT,
                scheduled_at TIMESTAMP NOT NULL,
                duration INTEGER DEFAULT 60,
                meeting_url TEXT,
                status VARCHAR(50) DEFAULT 'upcoming',
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
            """
        )

        connection.commit()

        cursor.execute(
            """
            SELECT COUNT(*)
            FROM live_classes
            """
        )

        count = cursor.fetchone()[0]

        if count == 0:

            now = datetime.now()

            class_one_time = (
                now + timedelta(hours=2)
            ).replace(
                minute=0,
                second=0,
                microsecond=0
            )

            class_two_time = (
                now + timedelta(days=1)
            ).replace(
                hour=18,
                minute=0,
                second=0,
                microsecond=0
            )

            class_three_time = (
                now + timedelta(days=2)
            ).replace(
                hour=17,
                minute=0,
                second=0,
                microsecond=0
            )

            sample_classes = [
                (
                    "Physics — Mechanics",
                    "Physics",
                    "Newton's Laws of Motion",
                    "Dr. Sharma",
                    "Interactive problem-solving session on Newton's Laws.",
                    class_one_time,
                    60,
                    "https://meet.google.com/",
                    "upcoming"
                ),
                (
                    "Mathematics — Calculus",
                    "Mathematics",
                    "Differentiation",
                    "Prof. Mehta",
                    "Learn the fundamentals of differentiation.",
                    class_two_time,
                    60,
                    "https://meet.google.com/",
                    "upcoming"
                ),
                (
                    "Chemistry — Organic",
                    "Chemistry",
                    "Organic Chemistry Basics",
                    "Dr. Roy",
                    "Introduction to important organic chemistry concepts.",
                    class_three_time,
                    60,
                    "https://meet.google.com/",
                    "upcoming"
                )
            ]

            cursor.executemany(
                """
                INSERT INTO live_classes (
                    title,
                    subject,
                    chapter,
                    teacher,
                    description,
                    scheduled_at,
                    duration,
                    meeting_url,
                    status
                )
                VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)
                """,
                sample_classes
            )

            connection.commit()
            print("Sample live classes added.")

        print("Live classes schema checked successfully.")

    except Exception as error:

        if connection:
            connection.rollback()

        print("Live classes schema error:", error)

    finally:

        if connection:
            connection.close()


# ============================================================
# UPDATE LIVE CLASS STATUS
# ============================================================

def update_live_class_statuses():

    connection = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute(
            """
            SELECT id, scheduled_at, duration
            FROM live_classes
            """
        )

        classes = cursor.fetchall()
        now = datetime.now()

        for class_id, scheduled_at, duration in classes:

            end_time = scheduled_at + timedelta(
                minutes=duration or 60
            )

            if now < scheduled_at:
                status = "upcoming"
            elif scheduled_at <= now < end_time:
                status = "live"
            else:
                status = "completed"

            cursor.execute(
                """
                UPDATE live_classes
                SET status = %s
                WHERE id = %s
                """,
                (status, class_id)
            )

        connection.commit()

    except Exception as error:

        if connection:
            connection.rollback()

        print("Live class status update error:", error)

    finally:

        if connection:
            connection.close()


# ============================================================
# STARTUP
# ============================================================

@app.on_event("startup")
def startup_event():

    print("Starting PrepMind AI backend...")

    ensure_password_reset_schema()
    ensure_chapter_progress_schema()
    ensure_live_classes_schema()
    update_live_class_statuses()

    print("PrepMind AI backend started.")


