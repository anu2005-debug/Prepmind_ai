            CREATE TABLE IF NOT EXISTS chapter_progress (
                id SERIAL PRIMARY KEY,
                student_id VARCHAR(100) NOT NULL,
                exam VARCHAR(100) NOT NULL,
                subject VARCHAR(100) NOT NULL,
                chapter VARCHAR(255) NOT NULL,
