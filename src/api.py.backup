# ============================================================
# REGISTER
# ============================================================

@app.post("/register")
def register(request: RegistrationRequest):

    if request.class_number not in [11, 12]:
        raise HTTPException(
            status_code=400,
            detail="Class must be either 11 or 12."
        )

    if len(request.password) < 6:
        raise HTTPException(
            status_code=400,
            detail="Password must contain at least 6 characters."
        )

    normalized_email = normalize_email(request.email)

    if not normalized_email:
        raise HTTPException(
            status_code=400,
            detail="Email is required."
        )

    if not request.name.strip():
        raise HTTPException(
            status_code=400,
            detail="Name is required."
        )

    connection = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute(
            """
            SELECT student_id
            FROM students
            WHERE LOWER(TRIM(email)) = %s
            """,
            (normalized_email,)
        )

        if cursor.fetchone():
            raise HTTPException(
                status_code=400,
                detail="An account with this email already exists."
            )

        student_id = (
            "PM"
            + str(datetime.now().year)
            + secrets.token_hex(3).upper()
        )

        password_hash = hash_password(request.password)

        cursor.execute(
            """
            INSERT INTO students (
                student_id,
                email,
                name,
                password,
                exam,
                class,
                class_number
            )
            VALUES (%s, %s, %s, %s, %s, %s, %s)
            """,
            (
                student_id,
                normalized_email,
                request.name.strip(),
                password_hash,
                request.exam,
                request.class_number,
                request.class_number
            )
        )

        connection.commit()

        return {
            "message": "Student registered successfully.",
            "student_id": student_id,
            "name": request.name.strip(),
            "email": normalized_email,
            "exam": request.exam,
            "class_number": request.class_number
        }

    except HTTPException:
        raise

    except Exception as error:

        if connection:
            connection.rollback()

        print("Registration error:", error)

        raise HTTPException(
            status_code=500,
            detail="Unable to register student."
        )

    finally:

        if connection:
            connection.close()


# ============================================================
# LOGIN
# ============================================================

@app.post("/login")
def login(data: dict):

    email = data.get("email")
    student_id = data.get("student_id")
    password = data.get("password")

    if not password:
        raise HTTPException(
            status_code=400,
            detail="Password is required."
        )

    normalized_email = (
        normalize_email(email)
        if email
        else None
    )

    if not normalized_email and not student_id:
        raise HTTPException(
            status_code=400,
            detail="Email or student ID is required."
        )

    connection = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        password_hash = hash_password(password)

        if normalized_email:

            cursor.execute(
                """
                SELECT
                    student_id,
                    name,
                    email,
                    exam,
                    COALESCE(class_number, class)
                FROM students
                WHERE LOWER(TRIM(email)) = %s
                AND password = %s
                """,
                (normalized_email, password_hash)
            )

        else:

            cursor.execute(
                """
                SELECT
                    student_id,
                    name,
                    email,
                    exam,
                    COALESCE(class_number, class)
                FROM students
                WHERE student_id = %s
                AND password = %s
                """,
                (student_id.strip(), password_hash)
            )

        student = cursor.fetchone()

        if not student:
            raise HTTPException(
                status_code=401,
                detail="Invalid email/student ID or password."
            )

        return {
            "message": "Login successful.",
            "student_id": student[0],
            "name": student[1],
            "email": student[2],
            "exam": student[3],
            "class_number": student[4]
        }

    except HTTPException:
        raise

    except Exception as error:

        print("Login error:", error)

        raise HTTPException(
            status_code=500,
            detail="Unable to login."
        )

    finally:

        if connection:
            connection.close()


