# ============================================================
# PROGRESS
# ============================================================

@app.get("/progress/{student_id}")
def get_progress(student_id: str):

    connection = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute(
            """
            SELECT student_id, exam
            FROM students
            WHERE student_id = %s
            """,
            (student_id,)
        )

        student = cursor.fetchone()

        if not student:
            raise HTTPException(
                status_code=404,
                detail="Student not found."
            )

        cursor.execute(
            """
            SELECT COUNT(*), COALESCE(AVG(score), 0)
            FROM interactions
            WHERE student_id = %s
            """,
            (student_id,)
        )

        overall = cursor.fetchone()

        questions_solved = int(overall[0] or 0)
        average_score = float(overall[1] or 0)

        cursor.execute(
            """
            SELECT
                c.subject,
                COALESCE(AVG(i.score), 0)
            FROM interactions AS i
            JOIN content AS c
                ON c.content_id = i.content_id
            WHERE i.student_id = %s
            GROUP BY c.subject
            ORDER BY c.subject
            """,
            (student_id,)
        )

        subject_rows = cursor.fetchall()

        subject_progress = {
            subject: round(float(score), 2)
            for subject, score in subject_rows
        }

        # The interactions table has no created_at column.
        # Keep the existing response field without querying a
        # nonexistent column. Accurate streaks need timestamps.
        study_streak = 0

        return {
            "student_id": student_id,
            "exam": student[1],
            "average_score": round(average_score, 2),
            "questions_solved": questions_solved,
            "study_streak": study_streak,
            "subject_progress": subject_progress
        }

    except HTTPException:
        raise

    except Exception as error:

        print("Progress error:", error)

        raise HTTPException(
            status_code=500,
            detail="Unable to fetch progress."
        )

    finally:

        if connection:
            connection.close()



# ============================================================
# FORGOT PASSWORD
# ============================================================

@app.post("/forgot-password")
def forgot_password(request: ForgotPasswordRequest):

    connection = None

    try:
        normalized_email = normalize_email(request.email)

        if not normalized_email:
            raise HTTPException(
                status_code=400,
                detail="Email is required."
            )

        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute(
            """
            SELECT student_id, email
            FROM students
            WHERE LOWER(TRIM(email)) = %s
            """,
            (normalized_email,)
        )

        student = cursor.fetchone()

        if not student:
            raise HTTPException(
                status_code=404,
                detail="No account found with this email."
            )

        student_id = student[0]
        recipient_email = student[1]

        # Keep the raw token only for the reset link.
        # Store its SHA-256 hash in PostgreSQL.
        token = secrets.token_urlsafe(32)
        token_hash = hash_reset_token(token)
        expires_at = datetime.now() + timedelta(minutes=15)

        cursor.execute(
            """
            UPDATE password_reset_tokens
            SET used = TRUE
            WHERE student_id = %s
            AND used = FALSE
            """,
            (student_id,)
        )

        cursor.execute(
            """
            INSERT INTO password_reset_tokens (
                student_id,
                token_hash,
                expires_at,
                used
            )
            VALUES (%s, %s, %s, FALSE)
            """,
            (student_id, token_hash, expires_at)
        )

        connection.commit()

        reset_url = (
            "http://localhost:3000/"
            "reset-password?token="
            + token
        )

        smtp_host = os.getenv("SMTP_HOST")
        smtp_port = os.getenv("SMTP_PORT")
        smtp_username = os.getenv("SMTP_USERNAME")
        smtp_password = os.getenv("SMTP_PASSWORD")

        if all([
            smtp_host,
            smtp_port,
            smtp_username,
            smtp_password
        ]):

            message = EmailMessage()
            message["Subject"] = "PrepMind AI Password Reset"
            message["From"] = smtp_username
            message["To"] = recipient_email

            message.set_content(
                f"""Hello,

We received a request to reset your PrepMind AI password.

Use the following link to reset your password:

{reset_url}

This link will expire in 15 minutes.

If you did not request this reset, you can ignore this email.

Regards,
PrepMind AI
"""
            )

            with smtplib.SMTP(
                smtp_host,
                int(smtp_port),
                timeout=20
            ) as server:

                server.starttls()
                server.login(smtp_username, smtp_password)
                server.send_message(message)

        return {
            "message": (
                "Password reset link generated successfully."
            ),
            "reset_url": reset_url
        }

    except HTTPException:
        raise

    except Exception as error:

        if connection:
            connection.rollback()

        print("Forgot password error:", error)

        raise HTTPException(
            status_code=500,
            detail="Unable to process password reset request."
        )

    finally:

        if connection:
            connection.close()


# ============================================================
# RESET PASSWORD
# ============================================================

@app.post("/reset-password")
def reset_password(request: ResetPasswordRequest):

    if len(request.new_password) < 6:
        raise HTTPException(
            status_code=400,
            detail="Password must contain at least 6 characters."
        )

    if not request.token.strip():
        raise HTTPException(
            status_code=400,
            detail="Password reset token is required."
        )

    connection = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        # Hash the supplied token to match the stored token_hash.
        token_hash = hash_reset_token(request.token)

        cursor.execute(
            """
            SELECT id, student_id, expires_at, used
            FROM password_reset_tokens
            WHERE token_hash = %s
            FOR UPDATE
            """,
            (token_hash,)
        )

        token_record = cursor.fetchone()

        if not token_record:
            raise HTTPException(
                status_code=400,
                detail="Invalid password reset token."
            )

        token_id, student_id, expires_at, used = token_record

        if used:
            raise HTTPException(
                status_code=400,
                detail="This password reset link has already been used."
            )

        if datetime.now() > expires_at:
            raise HTTPException(
                status_code=400,
                detail="This password reset link has expired."
            )

        new_password_hash = hash_password(request.new_password)

        cursor.execute(
            """
            UPDATE students
            SET password = %s
            WHERE student_id = %s
            """,
            (new_password_hash, student_id)
        )

        if cursor.rowcount == 0:
            raise HTTPException(
                status_code=404,
                detail="Student account not found."
            )

        cursor.execute(
            """
            UPDATE password_reset_tokens
            SET used = TRUE
            WHERE id = %s
            """,
            (token_id,)
        )

        connection.commit()

        return {
            "message": "Password reset successfully."
        }

    except HTTPException:
        if connection:
            connection.rollback()
        raise

    except Exception as error:

        if connection:
            connection.rollback()

        print("Reset password error:", error)

        raise HTTPException(
            status_code=500,
            detail="Unable to reset password."
        )

    finally:

        if connection:
            connection.close()


# ============================================================
# GET CHAPTER PROGRESS
