    version="1.0.0"
)


# ============================================================
# CORS
# ============================================================

app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "http://localhost:3000",
        "http://127.0.0.1:3000"
    ],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# ============================================================
# REQUEST MODELS
# ============================================================

class FeedbackRequest(BaseModel):
    student_id: str
    content_id: str
    score: float
    time_spent: int


class RegistrationRequest(BaseModel):
    name: str
    email: str
    password: str
    exam: str
    class_number: int


class ForgotPasswordRequest(BaseModel):
    email: str


class ResetPasswordRequest(BaseModel):
    token: str
    new_password: str


class ChapterProgressRequest(BaseModel):
    student_id: str
    exam: str
    subject: str
    chapter: str
    progress: int = Field(ge=0, le=100)
    completed: bool = False


# ============================================================
# PASSWORD HASHING
# ============================================================

def hash_password(password: str) -> str:
    return hashlib.sha256(
        password.encode("utf-8")
    ).hexdigest()


def hash_reset_token(token: str) -> str:
    """Store only a hash of the password-reset token."""
    return hashlib.sha256(
        token.encode("utf-8")
    ).hexdigest()


# ============================================================
# EMAIL NORMALIZATION
# ============================================================

def normalize_email(email: str) -> str:
    return email.strip().lower()


# ============================================================
# PASSWORD RESET AND STUDENT SCHEMA
# ============================================================

def ensure_password_reset_schema():

    connection = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute(
            """
            ALTER TABLE students
            ADD COLUMN IF NOT EXISTS email VARCHAR(255)
            """
        )

        cursor.execute(
            """
            ALTER TABLE students
            ADD COLUMN IF NOT EXISTS name VARCHAR(255)
            """
        )

        cursor.execute(
            """
            ALTER TABLE students
            ADD COLUMN IF NOT EXISTS class_number INTEGER
            """
        )

        cursor.execute(
            """
            UPDATE students
            SET class_number = class
            WHERE class_number IS NULL
            """
        )

        # This matches the existing password_reset_tokens table.
        # CREATE TABLE IF NOT EXISTS does not change an existing table.
        cursor.execute(
            """
            CREATE TABLE IF NOT EXISTS password_reset_tokens (
                id SERIAL PRIMARY KEY,
                student_id VARCHAR(255) NOT NULL,
                token_hash VARCHAR(64) NOT NULL,
                expires_at TIMESTAMP NOT NULL,
                used BOOLEAN NOT NULL DEFAULT FALSE,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
            """
        )

        connection.commit()
        print("Password reset schema checked successfully.")

    except Exception as error:

        if connection:
            connection.rollback()

        print("Password reset schema error:", error)

    finally:

        if connection:
            connection.close()


# ============================================================
# CHAPTER PROGRESS SCHEMA
# ============================================================

def ensure_chapter_progress_schema():

    connection = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute(
