@app.get("/chapter-progress/{student_id}")
def get_chapter_progress(student_id: str, exam: str):

    connection = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute(
            """
            SELECT subject, chapter, progress, completed
            FROM chapter_progress
            WHERE student_id = %s
            AND exam = %s
            ORDER BY subject, chapter
            """,
            (student_id, exam)
        )

        rows = cursor.fetchall()

        chapters = [
            {
                "subject": row[0],
                "chapter": row[1],
                "progress": row[2],
                "completed": row[3]
            }
            for row in rows
        ]

        return {
            "student_id": student_id,
            "exam": exam,
            "chapters": chapters
        }

    except Exception as error:

        print("Get chapter progress error:", error)

        raise HTTPException(
            status_code=500,
            detail="Unable to fetch chapter progress."
        )

    finally:

        if connection:
            connection.close()


# ============================================================
# UPDATE CHAPTER PROGRESS
# ============================================================

@app.post("/chapter-progress")
def update_chapter_progress(request: ChapterProgressRequest):

    connection = None

    try:
        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute(
            """
            INSERT INTO chapter_progress (
                student_id,
                exam,
                subject,
                chapter,
                progress,
                completed,
                updated_at
            )
            VALUES (%s, %s, %s, %s, %s, %s, CURRENT_TIMESTAMP)
            ON CONFLICT (student_id, exam, subject, chapter)
            DO UPDATE SET
                progress = EXCLUDED.progress,
                completed = EXCLUDED.completed,
                updated_at = CURRENT_TIMESTAMP
            """,
            (
                request.student_id,
                request.exam,
                request.subject,
                request.chapter,
                request.progress,
                request.completed
            )
        )

        connection.commit()

        return {
            "message": "Chapter progress updated successfully.",
            "student_id": request.student_id,
            "exam": request.exam,
            "subject": request.subject,
            "chapter": request.chapter,
            "progress": request.progress,
            "completed": request.completed
        }

    except Exception as error:

        if connection:
            connection.rollback()

        print("Update chapter progress error:", error)

        raise HTTPException(
            status_code=500,
            detail="Unable to update chapter progress."
        )

    finally:

        if connection:
            connection.close()


# ============================================================
# GET ALL LIVE CLASSES
# ============================================================

@app.get("/live-classes")
def get_live_classes():

    connection = None

    try:
        update_live_class_statuses()

        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute(
            """
            SELECT
                id,
                title,
                subject,
                chapter,
                teacher,
                description,
                scheduled_at,
                duration,
                meeting_url,
                status
            FROM live_classes
            ORDER BY scheduled_at ASC
            """
        )

        rows = cursor.fetchall()
        classes = []

        for row in rows:

            scheduled_at = row[6]

            classes.append({
                "id": row[0],
                "title": row[1],
                "subject": row[2],
                "chapter": row[3],
                "teacher": row[4],
                "description": row[5],
                "scheduled_at": (
                    scheduled_at.isoformat()
                    if scheduled_at
                    else None
                ),
                "duration": row[7],
                "meeting_url": row[8],
                "status": row[9]
            })

        return {"classes": classes}

    except Exception as error:

        print("Get live classes error:", error)

        raise HTTPException(
            status_code=500,
            detail="Unable to fetch live classes."
        )

    finally:

        if connection:
            connection.close()


# ============================================================
# GET SINGLE LIVE CLASS
# ============================================================

@app.get("/live-classes/{class_id}")
def get_live_class(class_id: int):

    connection = None

    try:
        update_live_class_statuses()

        connection = get_connection()
        cursor = connection.cursor()

        cursor.execute(
            """
            SELECT
                id,
                title,
                subject,
                chapter,
                teacher,
                description,
                scheduled_at,
                duration,
                meeting_url,
                status
            FROM live_classes
            WHERE id = %s
            """,
            (class_id,)
        )

        row = cursor.fetchone()

        if not row:
            raise HTTPException(
                status_code=404,
                detail="Live class not found."
            )

        scheduled_at = row[6]

        return {
            "id": row[0],
            "title": row[1],
            "subject": row[2],
            "chapter": row[3],
            "teacher": row[4],
            "description": row[5],
            "scheduled_at": (
                scheduled_at.isoformat()
                if scheduled_at
                else None
            ),
            "duration": row[7],
            "meeting_url": row[8],
            "status": row[9]
        }

    except HTTPException:
        raise

    except Exception as error:

        print("Get live class error:", error)

        raise HTTPException(
            status_code=500,
            detail="Unable to fetch live class."
        )

    finally:

        if connection:
            connection.close()