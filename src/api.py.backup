                updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                UNIQUE(student_id, exam, subject, chapter)
            )
            """
        )

        connection.commit()
        print("Chapter progress schema checked successfully.")

    except Exception as error:

        if connection:
            connection.rollback()

